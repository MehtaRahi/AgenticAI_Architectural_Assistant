# Application Environment Configuration

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=supersecret-key-change-in-production

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# LLM & Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1
EMBEDDING_MODEL=nomic-embed-text

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=architecture_db

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_BUCKET_NAME=architectural-documents
MINIO_SECURE=False

# Vector Store (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./data/processed/chroma_db
CHROMA_COLLECTION_NAME=architectural_standards

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=architectural_assistant_eval
